<!--
  Compatibility entry point. Channel-specific builds should use:
    Scripts\Build\nightly.proj
    Scripts\Build\canary.proj
    Scripts\Build\build.proj
    Scripts\Build\debug.proj
  Override with /p:Configuration=Nightly (etc.) still works because command-line
  properties take precedence over the default Release in build.proj.
-->
<Project DefaultTargets="Build">
	<Import Project="Scripts\Build\build.proj" />
</Project>
